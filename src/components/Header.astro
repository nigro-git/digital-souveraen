---
import { leistungen } from "../lib/leistungen-data";

const nav = [
  {
    label: "Leistungen",
    href: "/leistungen",
    teaser: "Europäische Alternativen, einzeln buchbar",
    children: leistungen.map((l) => ({ label: l.title, href: `/leistungen/${l.slug}` })),
  },
  { label: "News", href: "/news" },
];
const currentPath = Astro.url.pathname;
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-8">
    <a href="/" class="flex shrink-0 items-center gap-2 text-lg font-bold text-foreground tracking-tight">
      <img src="/logo.png" alt="Digital Souverän" class="h-8 w-8" loading="eager" />
      Digital Souverän
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {nav.map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class={`px-4 py-2 text-sm rounded transition-colors flex items-center gap-1
              ${currentPath.startsWith(item.href) ? "text-[#1a1a1a] bg-gray-100 font-medium" : "text-gray-500 hover:text-[#1a1a1a] hover:bg-gray-100"}`}
          >
            {item.label}
            {item.children && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
          </a>
          {item.children && (
            <div class="absolute top-full left-0 pt-1 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-150">
              <div class="bg-white rounded-lg p-1 min-w-[240px] shadow-xl border border-gray-200">
                {item.teaser && (
                  <p class="border-b border-gray-100 px-3 pb-2 pt-1.5 font-mono text-[11px] leading-snug text-gray-400">{item.teaser}</p>
                )}
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class={`block px-3 py-2 text-sm rounded transition-colors
                      ${currentPath === child.href ? "text-[#1a1a1a] bg-gray-100 font-medium" : "text-gray-500 hover:text-[#1a1a1a] hover:bg-gray-100"}`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <a
      href="/kontakt"
      class="inline-flex items-center px-5 py-2 text-sm font-medium bg-[#1a1a1a] text-white rounded hover:opacity-80 transition-opacity"
    >
      Gespräch anfragen
    </a>
  </div>
</header>
