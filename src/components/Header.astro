---
import { leistungen } from "../lib/leistungen-data";

const nav = [
  {
    label: "Leistungen",
    href: "/leistungen",
    teaser: "Europäische Alternativen, einzeln buchbar",
    children: leistungen.map((l) => ({ label: l.title, href: `/leistungen/${l.slug}` })),
  },
  { label: "News", href: "/news" },
];
const currentPath = Astro.url.pathname;
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-8">
    <a href="/" class="flex shrink-0 items-center gap-2 text-lg font-bold text-foreground tracking-tight">
      <img src="/logo.png" alt="Digital Souverän" class="h-8 w-8" loading="eager" />
      Digital Souverän
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {nav.map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class={`px-4 py-2 text-sm rounded transition-colors flex items-center gap-1
              ${currentPath.startsWith(item.href) ? "text-[#1a1a1a] bg-gray-100 font-medium" : "text-gray-500 hover:text-[#1a1a1a] hover:bg-gray-100"}`}
          >
            {item.label}
            {item.children && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
          </a>
          {item.children && (
            <div class="absolute top-full left-0 pt-1 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-150">
              <div class="bg-white rounded-lg p-1 min-w-[240px] shadow-xl border border-gray-200">
                {item.teaser && (
                  <p class="border-b border-gray-100 px-3 pb-2 pt-1.5 font-mono text-[11px] leading-snug text-gray-400">{item.teaser}</p>
                )}
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class={`block px-3 py-2 text-sm rounded transition-colors
                      ${currentPath === child.href ? "text-[#1a1a1a] bg-gray-100 font-medium" : "text-gray-500 hover:text-[#1a1a1a] hover:bg-gray-100"}`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <a
      href="mailto:kontakt@digipub.de"
      class="hidden md:inline-flex items-center px-5 py-2 text-sm font-medium bg-[#1a1a1a] text-white rounded hover:opacity-80 transition-opacity"
    >
      Gespräch anfragen
    </a>

    <button id="mob-btn" class="md:hidden relative flex h-9 w-9 items-center justify-center p-2 text-[#1a1a1a]" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mob-menu">
      <span class="hamburger-icon absolute inset-0 flex flex-col items-center justify-center gap-[5px] transition-opacity duration-200">
        <span class="block h-[2px] w-5 bg-current"></span>
        <span class="block h-[2px] w-5 bg-current"></span>
        <span class="block h-[2px] w-5 bg-current"></span>
      </span>
      <span class="close-icon absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </span>
    </button>
  </div>

  <div
    id="mob-menu"
    class="md:hidden fixed inset-0 top-16 z-40 flex flex-col overflow-y-auto bg-white px-6 pb-10 pt-6"
    style="opacity:0; pointer-events:none; transform: translateY(-8px); transition: opacity 0.25s ease, transform 0.25s ease;"
  >
    <nav class="flex flex-1 flex-col gap-1">
      {nav.map((item) => (
        <div class="border-b border-gray-100 py-3">
          <a
            href={item.href}
            class={`block text-xl font-semibold transition-colors ${currentPath.startsWith(item.href) ? "text-[#1a1a1a]" : "text-gray-700"}`}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="mt-2 flex flex-col gap-1 pl-1">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class={`py-1.5 text-sm transition-colors ${currentPath === child.href ? "font-medium text-[#1a1a1a]" : "text-gray-500"}`}
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <a
      href="mailto:kontakt@digipub.de"
      class="mt-6 block rounded bg-[#1a1a1a] px-5 py-3.5 text-center text-sm font-medium text-white transition-opacity hover:opacity-80"
    >
      Gespräch anfragen
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById("mob-btn");
  const menu = document.getElementById("mob-menu") as HTMLElement | null;
  const hamburger = btn?.querySelector(".hamburger-icon") as HTMLElement | null;
  const close = btn?.querySelector(".close-icon") as HTMLElement | null;

  let open = false;

  function setOpen(next: boolean) {
    open = next;
    if (!menu || !hamburger || !close || !btn) return;
    menu.style.opacity = open ? "1" : "0";
    menu.style.pointerEvents = open ? "auto" : "none";
    menu.style.transform = open ? "translateY(0)" : "translateY(-8px)";
    hamburger.style.opacity = open ? "0" : "1";
    close.style.opacity = open ? "1" : "0";
    btn.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  btn?.addEventListener("click", () => setOpen(!open));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
