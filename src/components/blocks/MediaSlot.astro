---
interface Props { src?: string; alt?: string; caption?: string; }
const { src, alt = "", caption } = Astro.props;
---

{src && (
  <figure class="m-0">
    <img {src} {alt} class="w-full rounded-lg" loading="lazy" />
    {caption && <figcaption class="mt-3 text-sm leading-relaxed text-muted-foreground">{caption}</figcaption>}
  </figure>
)}
