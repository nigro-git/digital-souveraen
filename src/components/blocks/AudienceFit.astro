---
interface Props {
  title: string;
  geeignet: string[];
  nichtGeeignet: string[];
  /** Überschreibt die Spaltenüberschrift "Gut geeignet" (z.B. "Nutzen"). */
  geeignetLabel?: string;
  /** Überschreibt die Spaltenüberschrift "Weniger geeignet" (z.B. "Grenzen"). */
  nichtGeeignetLabel?: string;
  /** true = zweite Spalte gleichrangig darstellen (z.B. Grenzen einer Fallstudie sind ebenso wichtig wie die Übertragbarkeit). */
  emphasizeSecond?: boolean;
}
const { title, geeignet, nichtGeeignet, geeignetLabel = "Gut geeignet", nichtGeeignetLabel = "Weniger geeignet", emphasizeSecond = false } = Astro.props;
---

<div>
  <h2 class="mb-8 font-bold text-foreground" style="font-size: var(--text-peak); letter-spacing: -0.01em;">{title}</h2>
  <div class="grid gap-8 sm:grid-cols-2">
    <div>
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.15em] text-primary">{geeignetLabel}</p>
      <ul class="space-y-3">
        {geeignet.map((item) => (
          <li class="leading-relaxed text-foreground" style="font-size: var(--text-body);">{item}</li>
        ))}
      </ul>
    </div>
    <div>
      <p class:list={["mb-4 font-mono text-xs uppercase tracking-[0.15em]", emphasizeSecond ? "text-[#c8860a]" : "text-muted-foreground"]}>{nichtGeeignetLabel}</p>
      <ul class="space-y-3">
        {nichtGeeignet.map((item) => (
          <li class:list={["leading-relaxed", emphasizeSecond ? "text-foreground" : "text-muted-foreground"]} style="font-size: var(--text-body);">{item}</li>
        ))}
      </ul>
    </div>
  </div>
</div>
