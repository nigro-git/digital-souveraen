---
interface Item { title: string; date: string; kicker: string; href: string; }
interface Props { title: string; items: Item[]; moreHref: string; moreLabel?: string; }
const { title, items, moreHref, moreLabel = "Alle Updates ansehen" } = Astro.props;
---

<div>
  <h2 class="mb-8 font-bold text-foreground" style="font-size: var(--text-peak); letter-spacing: -0.01em;">{title}</h2>
  <div class="grid border-l border-t border-border sm:grid-cols-3">
    {items.map((item) => (
      <a href={item.href} class="group flex flex-col border-b border-r border-border p-6">
        <span class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">{item.date}</span>
        <h3 class="mb-2 font-bold text-foreground transition-colors group-hover:text-primary" style="font-size: var(--text-body); line-height: 1.3;">{item.title}</h3>
        <p class="mb-4 text-sm leading-relaxed text-muted-foreground">{item.kicker}</p>
        <span class="mt-auto inline-block font-mono text-xs text-foreground transition-transform group-hover:translate-x-1" aria-hidden="true">Mehr →</span>
      </a>
    ))}
  </div>
  <p class="mt-4">
    <a href={moreHref} class="font-mono text-sm text-muted-foreground transition-colors hover:text-foreground">{moreLabel} →</a>
  </p>
</div>
