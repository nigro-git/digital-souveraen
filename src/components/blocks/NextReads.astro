---
import { blogPosts } from "../../lib/blog-data";
interface Props { slugs: string[]; title?: string; }
const { slugs, title = "Als Nächstes lesen" } = Astro.props;
const posts = slugs.map((s) => blogPosts.find((p) => p.slug === s)).filter((p): p is (typeof blogPosts)[number] => !!p);
---

{posts.length > 0 && (
  <div>
    <h2 class="mb-4 font-mono text-xs font-normal uppercase tracking-[0.15em] text-muted-foreground">{title}</h2>
    <div class:list={["grid border-l border-t border-border", posts.length > 1 && "sm:grid-cols-2"]}>
      {posts.map((p) => (
        <a href={`/blog/${p.slug}`} class="group flex flex-col border-b border-r border-border p-6">
          <span class="mb-3 font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">{p.format} · {p.clusters[0]}</span>
          <h3 class="mb-2 font-bold text-foreground transition-colors group-hover:text-primary" style="font-size: var(--text-body); line-height: 1.3;">{p.title}</h3>
          <p class="mb-4 text-sm leading-relaxed text-muted-foreground">{p.kicker}</p>
          <span class="mt-auto inline-block font-mono text-xs text-foreground transition-transform group-hover:translate-x-1" aria-hidden="true">Weiterlesen →</span>
        </a>
      ))}
    </div>
  </div>
)}
