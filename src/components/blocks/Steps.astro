---
interface Step { titel: string; text: string; deliverable?: string; }
interface Props { title: string; steps: Step[]; }
const { title, steps } = Astro.props;
---

<div>
  <h2 class="mb-8 font-bold text-foreground" style="font-size: var(--text-peak); letter-spacing: -0.01em;">{title}</h2>
  <ol class="space-y-8">
    {steps.map((step, i) => (
      <li class="flex gap-5">
        <span class="font-mono text-sm text-muted-foreground tabular-nums">{String(i + 1).padStart(2, "0")}</span>
        <div>
          <p class="mb-1 font-bold text-foreground" style="font-size: var(--text-body);">{step.titel}</p>
          <p class="leading-relaxed text-muted-foreground" style="font-size: var(--text-body);">{step.text}</p>
          {step.deliverable && (
            <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-primary">Deliverable: {step.deliverable}</p>
          )}
        </div>
      </li>
    ))}
  </ol>
</div>
