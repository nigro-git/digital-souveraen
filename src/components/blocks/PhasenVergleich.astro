---
interface Column { label: string; text?: string; items?: string[]; }
interface Props {
  heading: string;
  /** Eine Zeile Kernaussage, fett hervorgehoben direkt unter der Überschrift – Scan-Anker bei mehreren aufeinanderfolgenden Phasen. */
  takeaway?: string;
  intro?: string;
  columns: Column[];
  note?: string;
}
const { heading, takeaway, intro, columns, note } = Astro.props;
---

<div class="border border-border">
  <div class="border-b border-border bg-muted/40 px-5 py-3">
    <p class="font-bold text-foreground" style="font-size: var(--text-body);">{heading}</p>
    {takeaway && <p class="mt-1 font-semibold text-primary" style="font-size: 0.9rem;">→ {takeaway}</p>}
  </div>
  {intro && <p class="border-b border-border px-5 py-4 leading-relaxed text-muted-foreground" style="font-size: var(--text-body);">{intro}</p>}
  <div class="grid gap-x-8 gap-y-4 p-5 sm:grid-cols-2">
    {columns.map((col, i) => (
      <div class:list={[i === 0 && "sm:border-r sm:border-border sm:pr-8"]}>
        <p class="mb-2 font-mono text-xs uppercase tracking-[0.1em] text-muted-foreground">{col.label}</p>
        {col.text && <p class="leading-relaxed text-foreground" style="font-size: var(--text-body);">{col.text}</p>}
        {col.items && (
          <ul class="list-disc list-outside space-y-1.5 pl-5 marker:text-primary">
            {col.items.map((item) => <li class="leading-relaxed text-foreground" style="font-size: var(--text-body);">{item}</li>)}
          </ul>
        )}
      </div>
    ))}
  </div>
  {note && <p class="border-t border-border bg-muted/40 px-5 py-4 text-sm leading-relaxed text-muted-foreground">{note}</p>}
</div>
