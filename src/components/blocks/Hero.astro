---
interface Tags { cluster: string; format: string; entities?: string[]; }
interface Props {
  eyebrow?: string;
  title: string;
  answerFirst: string;
  tags?: Tags;
  /** Kurze Stichwort-Chips direkt unter der H1 (z.B. Startseite). */
  chips?: string[];
  /** true = helle Schrift für dunkle Hintergründe (z.B. Hero mit Bild). */
  dark?: boolean;
}
const { eyebrow, title, answerFirst, tags, chips, dark = false } = Astro.props;
// "\n" im Titel = bewusster Zeilenumbruch (Leerzeichen bleibt für Screenreader/Suchmaschinen erhalten)
const titleLines = title.split("\n");
---

<div class:list={["max-w-4xl", chips && "w-fit max-w-full"]}>
  {eyebrow && (
    <p class:list={["mb-4 font-mono text-xs uppercase tracking-[0.2em]", dark ? "text-sky-300" : "text-primary"]}>{eyebrow}</p>
  )}
  <h1 class:list={["font-bold", dark ? "text-white" : "text-foreground"]} style="font-size: var(--text-section); line-height: 1.08; letter-spacing: -0.02em;">
    {titleLines.map((line, i) => (
      <Fragment>{i > 0 && <br />}{line}{i < titleLines.length - 1 && " "}</Fragment>
    ))}
  </h1>
  {chips && chips.length > 0 && (
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Unser Ansatz">
      {chips.map((chip) => (
        <li class:list={["rounded-full border px-3 py-1 font-mono text-[11px] uppercase tracking-[0.06em]", dark ? "border-white/40 bg-white/10 text-white" : "border-foreground text-foreground"]}>{chip}</li>
      ))}
    </ul>
  )}
  {tags && (
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="rounded-full bg-foreground px-3 py-1 font-mono text-[11px] uppercase tracking-[0.06em] text-background">{tags.cluster}</span>
      <span class="rounded-full border border-foreground px-3 py-1 font-mono text-[11px] uppercase tracking-[0.06em] text-foreground">{tags.format}</span>
      {tags.entities?.map((entity) => (
        <span class="rounded-full border border-border px-3 py-1 font-mono text-[11px] text-muted-foreground">{entity}</span>
      ))}
    </div>
  )}
  <p class:list={["mt-6 border-l-2 pl-5 leading-relaxed", chips ? "w-0 min-w-full" : "max-w-2xl", dark ? "border-sky-300 text-white/85" : "border-primary text-foreground/75"]} style="font-size: var(--text-body);">
    {answerFirst}
  </p>
</div>
