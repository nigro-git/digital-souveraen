---
interface Group { label: string; items: string[]; }
interface Props { dataGapNote?: string; groups: Group[]; }
const { dataGapNote, groups } = Astro.props;
---

<div>
  {dataGapNote && (
    <p class="mb-6 max-w-3xl border-l-2 border-border pl-4 text-sm leading-relaxed text-muted-foreground">
      <span class="font-mono text-xs uppercase tracking-[0.1em] text-muted-foreground">⚠ Hinweis zur Datenlage · </span>
      {dataGapNote}
    </p>
  )}
  <div class="grid gap-8 sm:grid-cols-3">
    {groups.map((group) => (
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.1em] text-muted-foreground">{group.label}</p>
        <ul class="space-y-2">
          {group.items.map((item) => <li class="text-sm leading-relaxed text-foreground">{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</div>
