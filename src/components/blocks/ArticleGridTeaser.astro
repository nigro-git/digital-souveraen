---
interface Post {
  title: string;
  kicker: string;
  format: string;
  clusters: string[];
  image?: string;
  meta: string;
  href: string;
}
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {posts.map((post) => (
    <a href={post.href} class="group border border-border" data-clusters={post.clusters.join("|")}>
      {post.image ? (
        <img src={post.image} alt="" class="aspect-[212/100] w-full border-b border-border object-cover" loading="lazy" />
      ) : (
        <div class="flex aspect-[212/100] w-full items-center justify-center border-b-2 border-dashed border-border">
          <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-muted-foreground">Kein Bild</span>
        </div>
      )}
      <div class="p-4">
        <div class="mb-2 flex flex-wrap gap-1.5">
          <span class="rounded-full bg-muted px-2.5 py-0.5 font-mono text-[9.5px] uppercase tracking-[0.06em] text-foreground">{post.clusters[0]}</span>
          <span class="rounded-full border border-border px-2.5 py-0.5 font-mono text-[9.5px] uppercase tracking-[0.06em] text-muted-foreground">{post.format}</span>
        </div>
        <h3 class="mb-1.5 font-bold text-foreground transition-colors group-hover:text-primary" style="font-size: 0.9rem; line-height: 1.3;">{post.title}</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">{post.kicker}</p>
        <p class="mt-2 font-mono text-[10px] text-muted-foreground">{post.meta}</p>
      </div>
    </a>
  ))}
</div>
