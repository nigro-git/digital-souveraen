---
interface Props { title: string; subtitle?: string; ctaLabel?: string; eyebrow?: string; }
const { title, subtitle, ctaLabel = "Gespräch vereinbaren", eyebrow = "mit unserem Spezialisten" } = Astro.props;
---

<div class="border-t border-border pt-10 text-center">
  <h2 class="mx-auto max-w-2xl font-bold text-foreground" style="font-size: var(--text-peak); letter-spacing: -0.01em;">{title}</h2>
  <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-muted-foreground">{eyebrow}</p>
  <a href="mailto:kontakt@digipub.de" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-foreground px-6 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-80">
    {ctaLabel} →
  </a>
  {subtitle && <p class="mx-auto mt-4 max-w-xl text-sm text-muted-foreground">{subtitle}</p>}
</div>
