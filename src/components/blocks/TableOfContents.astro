---
interface Item { id: string; label: string; highlight?: boolean; }
interface Props { items: Item[]; readTime?: string; highlightLabel?: string; }
const { items, readTime, highlightLabel = "Empfehlung" } = Astro.props;
---

<div class="rounded-lg border border-border px-6 py-5">
  <p class="mb-3 font-mono text-xs uppercase tracking-[0.1em] text-muted-foreground">
    Auf dieser Seite{readTime && ` · ${readTime}`}
  </p>
  <div class="grid gap-x-8 gap-y-1 sm:grid-cols-2">
    {items.map((item, i) => (
      <a href={`#${item.id}`} class="flex items-baseline gap-2.5 rounded py-1.5 text-foreground transition-colors hover:text-primary">
        <span class="font-mono text-xs tabular-nums text-muted-foreground">{String(i + 1).padStart(2, "0")}</span>
        <span class="text-sm">{item.label}</span>
        {item.highlight && (
          <span class="shrink-0 rounded-full bg-primary/10 px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.06em] text-primary">{highlightLabel}</span>
        )}
      </a>
    ))}
  </div>
</div>
