---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import Breadcrumb from "../../components/blocks/Breadcrumb.astro";
import Hero from "../../components/blocks/Hero.astro";
import MediaSlot from "../../components/blocks/MediaSlot.astro";
import TableOfContents from "../../components/blocks/TableOfContents.astro";
import Context from "../../components/blocks/Context.astro";
import Steps from "../../components/blocks/Steps.astro";
import DataTable from "../../components/blocks/DataTable.astro";
import Contrast from "../../components/blocks/Contrast.astro";
import Related from "../../components/blocks/Related.astro";
import NextReads from "../../components/blocks/NextReads.astro";
import { readTime } from "../../lib/readTime";
import CtaBar from "../../components/blocks/CtaBar.astro";
import { articleImage } from "../../lib/articleImages";
import { buildBreadcrumbSchema } from "../../lib/schemaOrg";
import * as article from "../../lib/blog-articles/was-kostet-digitale-souveraenitaet";

const pageUrl = new URL("/blog/was-kostet-digitale-souveraenitaet", Astro.site).href;
const breadcrumbSchema = buildBreadcrumbSchema([
  { label: "Digital Souverän", url: new URL("/", Astro.site).href },
  { label: "Blog", url: new URL("/blog", Astro.site).href },
  { label: article.meta.title, url: pageUrl },
]);

const tocItems = [
  { id: "warum", label: article.warum.heading },
  { id: "ebenen", label: "Die fünf Kostenebenen" },
  { id: "rechnung", label: "Kostenrechnung zusammenführen", highlight: true },
  { id: "faktoren", label: article.faktoren.heading },
  { id: "grenzen", label: article.grenzen.heading },
];
---

<Layout
  seoKey="blog-was-kostet-digitale-souveraenitaet"
  title={`${article.meta.title} | Digital Souverän`}
  description={article.meta.answerFirst.slice(0, 155)}
  ogImage={articleImage("was-kostet-digitale-souveraenitaet", "og")}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Section id="artikel">
    <Breadcrumb items={[
      { label: "Digital Souverän", href: "/" },
      { label: "Blog", href: "/blog" },
      { label: article.meta.title },
    ]} />

    <Hero title={article.meta.title} answerFirst={article.meta.answerFirst} tags={article.meta.tags} />

    <div class="mt-10">
      <MediaSlot src={articleImage("was-kostet-digitale-souveraenitaet", "hero")} alt={article.meta.title} />
    </div>

    <div class="mt-10">
      <TableOfContents items={tocItems} readTime={readTime(article)} highlightLabel="Werkzeug" />
    </div>

    <div id="warum" class="mt-14 scroll-mt-24">
      <Context tone="article" headline={article.warum.heading} hinweis={undefined}>
        <div class="space-y-4">
          {article.warum.absaetze.map((a) => <p>{a}</p>)}
          <p><strong class="text-foreground">Wichtiger Hinweis:</strong> {article.warum.hinweis}</p>
        </div>
      </Context>
    </div>

    <div id="ebenen" class="mt-14 scroll-mt-24">
      <Steps title={article.ebenen.heading} steps={article.ebenen.steps} numberPrefix="Ebene" />
    </div>

    <div id="rechnung" class="mt-14 scroll-mt-24">
      <DataTable title={article.rechnung.heading} headers={article.rechnung.headers} rows={article.rechnung.rows} caption={article.rechnung.caption} />
    </div>

    <div id="faktoren" class="mt-14 scroll-mt-24">
      <Contrast
        title={article.faktoren.heading}
        nichtLabel="Erhöht eher die Kosten"
        sondernLabel="Spricht eher für günstigere Wirtschaftlichkeit"
        nicht={article.faktoren.teurer}
        sondern={article.faktoren.guenstiger}
      />
      <p class="mt-6 max-w-3xl text-sm text-muted-foreground">{article.faktoren.hinweis}</p>
    </div>

    <div id="grenzen" class="mt-14 scroll-mt-24">
      <Context tone="article" headline={article.grenzen.heading}>
        <p>{article.grenzen.text}</p>
      </Context>
    </div>

    <div class="mt-14">
      <NextReads slugs={["opendesk-vs-microsoft-365","was-passiert-wenn-unternehmen-nichts-tun"]} />
    </div>

    <div class="mt-10">
      <Related links={article.related.links} upHref={article.related.upHref} upLabel={article.related.upLabel} />
    </div>

    <div class="mt-16">
      <CtaBar title={article.cta.title} subtitle={article.cta.subtitle} ctaLabel={article.cta.ctaLabel} eyebrow={article.cta.eyebrow} />
    </div>
  </Section>
</Layout>
