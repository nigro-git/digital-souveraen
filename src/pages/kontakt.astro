---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
---

<Layout seoKey="kontakt" title="Kontakt | Digital Souverän" description="Kostenloses Erstgespräch zur digitalen Souveränität Ihres Unternehmens – mit Nicolas Grossman, DigiPub Berlin.">
  <Section id="kontakt">
    <h1 class="font-bold text-foreground" style="font-size: var(--text-section); line-height: 1.08; letter-spacing: -0.02em;">
      Sprechen wir über Ihre Ausgangslage.
    </h1>
    <p class="mt-6 max-w-2xl border-l-2 border-primary pl-5 leading-relaxed text-foreground/75" style="font-size: var(--text-body);">
      Kostenfreies Erstgespräch
    </p>
    <p class="mt-8">
      <a href="mailto:kontakt@digipub.de" class="inline-flex items-center gap-2 rounded-lg bg-foreground px-6 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-80">
        Kontakt aufnehmen
      </a>
    </p>
  </Section>
</Layout>
